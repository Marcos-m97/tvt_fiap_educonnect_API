<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Oculta warnings de nullability e resolução de pacote durante a compilação -->
    <NoWarn>$(NoWarn);CS8618;CS8604;CS8601;CS8602;NU1603</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="NovaPasta\**" />
    <Compile Remove="wwwroot\perfis\**" />
    <Content Remove="NovaPasta\**" />
    <Content Remove="wwwroot\perfis\**" />
    <EmbeddedResource Remove="NovaPasta\**" />
    <EmbeddedResource Remove="wwwroot\perfis\**" />
    <None Remove="NovaPasta\**" />
    <None Remove="wwwroot\perfis\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- BCrypt -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />

    <!-- QuestPDF: ajustado para a versão que o NuGet já estava resolvendo -->
    <PackageReference Include="QuestPDF" Version="2024.3.0" />

    <!-- Swagger (compatível com net8.0) -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.8.0" />

    <!-- EF Core 8 (compatível com net8.0) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.6" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.6" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.6">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="uploads\" />
    <Folder Include="wwwroot\" />
  </ItemGroup>

</Project>